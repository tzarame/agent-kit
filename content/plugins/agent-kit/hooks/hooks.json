{
  "description": "The rules for the session and for each subagent; a command for the owner goes through the gate owner-run; the analyst asks about a new finding",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-rules.sh\"", "timeout": 30}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/owner-approve.sh\"", "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-rules.sh\"", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/owner-stop.sh\"", "timeout": 15},
      {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/analyst-stop.sh\"", "timeout": 15}]}]
  }
}
